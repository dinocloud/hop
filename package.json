{
  "name": "hop-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HOP · WhatsApp sobre AWS End User Messaging Social + Amazon Bedrock AgentCore",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:agent": "node agent/esbuild.config.mjs",
    "synth": "cdk synth --strict --quiet",
    "diff": "cdk diff HopHackathonDev",
    "deploy:ci-role": "cdk deploy HopHackathonCi",
    "seed": "tsx scripts/seed.ts",
    "cdk": "cdk",
    "send:test": "tsx scripts/send-test.ts",
    "smoke:agent": "node scripts/smoke-agent.mjs",
    "publish:inbound": "tsx scripts/publish-inbound.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-sns": "^3.1152.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^22.19.0",
    "aws-cdk": "^2.1100.0",
    "aws-cdk-lib": "^2.273.0",
    "aws-sdk-client-mock": "^4.1.0",
    "cdk-nag": "^2.37.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.28.0",
    "@aws-lambda-powertools/metrics": "^2.36.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-socialmessaging": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@strands-agents/sdk": "^1.21.0",
    "bedrock-agentcore": "^0.4.5",
    "zod": "^4.1.0"
  }
}
